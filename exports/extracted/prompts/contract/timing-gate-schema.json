{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TimingGateOutput",
  "description": "Timing Gate 节奏控制决策输出",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["continue", "wait", "no_action"],
      "description": "节奏控制动作"
    },
    "waitSec": {
      "type": "integer",
      "minimum": 0,
      "description": "wait 动作的等待秒数；其他动作时可省略"
    },
    "reason": {
      "type": "string",
      "maxLength": 200,
      "description": "决策理由（用于审计与日志，不会展示给用户）"
    }
  },
  "additionalProperties": false
}
