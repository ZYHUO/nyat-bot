{
  "name": "nyat-bot",
  "version": "0.2.0",
  "description": "NyatBot — Telegram AI 群聊喵娘机器人，拟人回复引擎",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "native/nyatdb",
    "miniapp-web"
  ],
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "build:nyatdb": "npm --prefix native/nyatdb run build",
    "migrate:nyatdb": "tsx scripts/migrate-to-nyatdb.ts",
    "build:nyatdb:debug": "npm --prefix native/nyatdb run build:debug",
    "build:miniapp": "npm --prefix miniapp-web run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:miniapp": "npm --prefix miniapp-web run test",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.22",
    "@hono/node-server": "^1.14.1",
    "@nyat/nyatdb": "*",
    "@nyat/context-engine": "*",
    "@qdrant/js-client-rest": "^1.18.0",
    "@xenova/transformers": "^2.17.2",
    "ai": "^4.3.16",
    "better-sqlite3": "^11.9.1",
    "bullmq": "^5.52.0",
    "dotenv": "^16.5.0",
    "fast-levenshtein": "^2.0.6",
    "grammy": "^1.35.0",
    "hono": "^4.7.10",
    "ioredis": "^5.6.1",
    "lru-cache": "^11.1.0",
    "nanoid": "^5.1.5",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "tiktoken": "^1.0.21",
    "undici": "^6.27.0",
    "zod": "^3.25.34"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/node": "^22.20.1",
    "@types/node-cron": "^3.0.11",
    "chromadb": "^3.4.3",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  }
}
