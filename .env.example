# ============================================================
# xxb-ts 环境变量模板
# 复制为 .env 并填写实际值
# ============================================================

# --- Telegram Bot (required) ---
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
BOT_USERNAME=xxb_bot

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- SQLite ---
SQLITE_PATH=./data/xxb.db

# --- Knowledge base (per-chat .md files, PHP parity) ---
# KNOWLEDGE_BASE_DIR=./data/knowledge
# JUDGE_KNOWLEDGE_ENABLED=false
# JUDGE_KNOWLEDGE_PERMANENT=true
# JUDGE_KNOWLEDGE_GROUP=true

# --- Knowledge cron (AI refresh of group .md; set chat IDs to enable) ---
# KNOWLEDGE_CRON_CHAT_IDS=-1001234567890
# KNOWLEDGE_CRON_SCHEDULE=30 * * * *
# KNOWLEDGE_CRON_HASH_PATH=./data/knowledge-cron-hashes.json

# --- Per-user persona files: prompts/persona/{uid}.md or .txt ---
# PERSONA_DIR=prompts/persona

# --- AI Providers / Routing (required) ---
# 核心 usage 部门: reply / judge / summarize / vision
# (+ 历史名 heart/planner/path_reflection/allowlist_review/reply_splitter/
# summarize_deep/heart_reflect 会自动别名到核心部门)。
AI_PROVIDER_REPLY_ENDPOINT=https://api.openai.com/v1
AI_PROVIDER_REPLY_KEY=***
AI_PROVIDER_REPLY_MODEL=gpt-4o-mini
AI_PROVIDER_VISION_ENDPOINT=https://api.openai.com/v1
AI_PROVIDER_VISION_KEY=***
AI_PROVIDER_VISION_MODEL=gpt-4o
AI_PROVIDER_JUDGE_ENDPOINT=https://api.openai.com/v1
AI_PROVIDER_JUDGE_KEY=***
AI_PROVIDER_JUDGE_MODEL=gpt-4o-mini
AI_PROVIDER_SUMMARIZE_ENDPOINT=https://api.openai.com/v1
AI_PROVIDER_SUMMARIZE_KEY=***
AI_PROVIDER_SUMMARIZE_MODEL=gpt-4o-mini
AI_USAGE_REPLY_LABEL=reply
AI_USAGE_VISION_LABEL=vision
AI_USAGE_JUDGE_LABEL=judge
AI_USAGE_SUMMARIZE_LABEL=summarize

# 兼容旧配置：AI_BASE_URL / AI_MODEL_* / LOCAL_AI_* 仍可继续使用，但新部署建议直接改成上面的 AI_PROVIDER_* / AI_USAGE_*。

# --- 本地模型 (Qwen / GLM 等，OpenAI-compatible，无 NSFW/政治内容) ---
# 用于: judge / summarize；不设置则继续走上面的 provider
# AI_PROVIDER_LOCAL_JUDGE_ENDPOINT=http://127.0.0.1:8317/v1
# AI_PROVIDER_LOCAL_JUDGE_KEY=***
# AI_PROVIDER_LOCAL_JUDGE_MODEL=glm-5
# AI_USAGE_JUDGE_LABEL=local_judge
# AI_PROVIDER_LOCAL_SUMMARIZE_ENDPOINT=http://127.0.0.1:8317/v1
# AI_PROVIDER_LOCAL_SUMMARIZE_KEY=***
# AI_PROVIDER_LOCAL_SUMMARIZE_MODEL=qwen3.6-plus
# AI_USAGE_SUMMARIZE_LABEL=local_summarize

# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- Webhook (optional — uses polling if not set) ---
# WEBHOOK_URL=https://your-domain.com/webhook
# WEBHOOK_SECRET=your-webhook-secret

# --- Queue ---
QUEUE_CONCURRENCY=20

# --- AI Tuning ---
HEDGE_DELAY_MS=2000

# --- Rate Limiting ---
RATE_LIMIT_PER_MIN=30

# --- Streaming ---
STREAMING_MIN_INTERVAL=500
STREAMING_MIN_CHARS=50

# --- Tool System (optional) ---
# SEARXNG_URL=http://localhost:8080
# FETCH_GATEWAY_URL=
# FETCH_WORKER_URL=https://your-fetch-worker.example.com
# NODESEEK_READER_URLS=https://r.jina.ai/{URL}
# WEB_FETCH_USER_AGENT=XXB-WebFetch/1.0
# IP_QUALITY_API_URL=https://your-ip-quality-api.example.com
# TIMER_API_URL=https://your-timer-api.example.com
# TIMER_CALLBACK_URL=https://your-callback-url.example.com
# COMMON_API_KEY=your-common-api-key
# CODEACT_PIXIV_ENABLED=false
# CODEACT_LINUXSB_ENABLED=false

# --- Task progress and reply style ---
# 长任务阶段通知：开始/搜索/核对/整理/续跑，失败静默，不影响任务执行
# TASK_PROGRESS_ENABLED=true
# TASK_PROGRESS_MIN_INTERVAL_MS=30000
# TASK_PROGRESS_MAX_VISIBLE_UPDATES=6
# TASK_PROGRESS_CODEACT_ENABLED=true
# TASK_PROGRESS_RESEARCH_ENABLED=true
# 回复形态：短反应、先接住再展开、认真回答
# REPLY_MODE_ENABLED=true
# REPLY_ACK_THEN_EXPAND_ENABLED=true
# REPLY_LONG_TEXT_SAFE_SPLIT_ENABLED=true
# REPLY_HUMANIZER_SAFE_MODE=true

# QDRANT_HOST=127.0.0.1
# QDRANT_PORT=6333
# 嵌入模型 / collection（换模型必须整库重嵌入到新 collection 再切，见 scripts/reembed-memory.mts）
# MEMORY_EMBED_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# MEMORY_COLLECTION=xxb_group_history_v2
# 相关性下限 0..1；0=不过滤。多语言模型下生产标定约 0.55（噪声 p90≈0.47）
# MEMORY_MIN_SCORE=0.55
# 混合检索：向量 + FTS5 BM25，RRF 融合。开之前先 --fts-only 对齐词法索引
# MEMORY_HYBRID_ENABLED=false
# 写入侧近重复合并（阈值须在新嵌入空间标定；旧英文模型下中文虚高，勿照搬）
# MEMORY_DEDUP_ENABLED=false
# MEMORY_DEDUP_THRESHOLD=0.93
# 隐私：visibility 层 + 跨上下文召回（双 flag fail-closed）
# MEMORY_VISIBILITY_ENABLED=false
# MEMORY_CROSS_CONTEXT_ENABLED=false

# --- Tracking ---
OUTCOME_TRACKING_ENABLED=false

# --- Business ---
MASTER_UID=0
BOT_NICKNAMES=xxb,啾咪囝
CONTEXT_MAX_LENGTH=600
JUDGE_WINDOW_SIZE=10

# --- Allowlist ---
ALLOWLIST_ENABLED=false
ALLOWLIST_REDIS_PREFIX=xxb:mal:
ALLOWLIST_DEFAULT_ENABLE_AFTER_APPROVE=false
ALLOWLIST_MAX_SUBMISSIONS_PER_DAY=20
ALLOWLIST_AUTO_AI_REVIEW=true
ALLOWLIST_AI_MESSAGE_LIMIT=100
ALLOWLIST_AI_CONTEXT_MAX_CHARS=24000
# AI 审核只写建议;enabled=true 必须经 master 手动动作(审核 prompt 吃用户可控的
# note/chat_title,可被注入 APPROVE)。要恢复自动启用需同时收紧 submit 的群管校验。
ALLOWLIST_AI_AUTO_ENABLE=false
ALLOWLIST_AI_CONFIDENCE_THRESHOLD=0.85
# Bot 对话流申请（替代 miniapp 提交）：申请人私聊 bot 报群 ID/@username，bot 自动审核。
# 仅申请人是目标群 creator/administrator（getChatMember 核实）时 AI 通过才直接启用，
# 否则 AI 结论只作建议转主人评判（note 用户可控，防注入自助开通）。
ALLOWLIST_BOT_FLOW_ENABLED=false
# bot 被拉进群 → 立即自动跑一遍 AI 审核（不等申请）。拉群人是群管理才可自动启用。
ALLOWLIST_REVIEW_ON_JOIN=false

# --- Cutover (required for scripts/cutover.sh) ---
# TS_WEBHOOK_URL=https://your-ts-domain.com/webhook
# PHP_WEBHOOK_URL=https://your-php-domain.com/webhook
# ADMIN_CORS_ORIGINS=http://localhost:5173,https://admin.example.com

# ── Channel Source (频道消息源，存入 ChromaDB 作为 AI 知识) ──
# 逗号分隔的频道 ID（负数），bot 需要是频道管理员
# CHANNEL_SOURCE_IDS=-1001234567890,-1009876543210
CHANNEL_SOURCE_IDS=

# ── Daily changelog push (bot 发送到频道) ──
# 频道 username（如 @jiumijuan）或 chat id；bot 需要能向该频道发言
# DAILY_CHANGELOG_CHANNEL=@jiumijuan
# TELEGRAM_BOT_TOKEN=123456...ew11

# ── Timing Gate (MaiBot-style 节奏控制；默认关闭) ──
# 启用后流程: handler → debounce(buffer) → producer → judge → timing-gate → reply
# 关闭时所有 timing 模块退化为透传，行为等价于改造前
TIMING_GATE_ENABLED=false

# 阶段 1: 消息去抖窗口（毫秒）。同一 chat 内短时间连发的消息会合并成一批
# 让 judge/gate/reply 只对最后一条做决策，避免打断用户连发
# 设为 0 关闭去抖
TIMING_DEBOUNCE_MS=2000
TIMING_DEBOUNCE_MAX_BUFFER_MS=8000

# 阶段 2: ChatRuntime 状态机过期时间（秒，默认 24 小时）
TIMING_STATE_TTL_SEC=86400

# 阶段 3: Timing Gate LLM 调用配置
# 用哪个 AI usage 跑 gate（建议小模型）
TIMING_GATE_USAGE=judge
TIMING_GATE_TIMEOUT_MS=8000

# 阶段 4: wait 工具时长边界 + gate 选 wait/no_action 后的冷却时间
TIMING_WAIT_MIN_SEC=5
TIMING_WAIT_MAX_SEC=120
TIMING_GATE_COOLDOWN_SEC=15

# === 主动加入讨论 (Stage B) ===
# 让 bot 偶尔主动加入热聊讨论。配合 timing-gate 一起用。
# 关闭时（默认）：bot 只在被 @ 或回复时才说话
JUDGE_PROACTIVE_ENABLED=false
JUDGE_PROACTIVE_RATE=0.25               # 命中 hot_chat 时有 25% 概率进入 L1 评估
JUDGE_PROACTIVE_MIN_INTERVAL_SEC=120    # 距上次 bot 回复至少 2 分钟
JUDGE_PROACTIVE_MIN_RECENT_MSGS=3       # 最近至少 3 条非-bot 消息

# === 主动扫群 Cron (Stage C) ===
# 周期扫描活跃群，主动判断是否该插一句。配合 timing-gate 一起用。
# 关闭时（默认）：cron 不注册，无任何开销
PROACTIVE_SCAN_ENABLED=false
PROACTIVE_SCAN_INTERVAL_MIN=5           # 每 5 分钟扫一次
PROACTIVE_SCAN_USAGE=judge              # 用哪个 AI usage 跑判断
PROACTIVE_SCAN_MIN_INTERVAL_SEC=900     # 同一群两次主动开口至少间隔 15 分钟
PROACTIVE_SCAN_MAX_CHATS_PER_TICK=3     # 每次 tick 最多评估 3 个群
PROACTIVE_SCAN_RECENT_MSG_COUNT=15      # 看最近多少条消息
PROACTIVE_SCAN_MIN_HUMAN_MSGS=5         # 至少 5 条人类消息才考虑
PROACTIVE_SCAN_HOUR_START=10            # 北京时间活跃窗口开始
PROACTIVE_SCAN_HOUR_END=23              # 北京时间活跃窗口结束

# === 表达学习 + 黑话挖掘 (Stage D) ===
# cron 周期扫群聊，LLM 提取表达方式和黑话候选词
# 关闭时（默认）：cron 不注册，无任何开销
LEARNER_ENABLED=false
LEARNER_SCAN_INTERVAL_MIN=60            # 每 60 分钟扫一次
LEARNER_SCAN_USAGE=judge                # 用哪个 AI usage 跑提取
LEARNER_BATCH_SIZE=80                   # 每次取多少条消息
LEARNER_MIN_NEW_MSGS=30                 # 至少 30 条新消息才触发
LEARNER_MAX_CHATS_PER_TICK=3            # 每次 tick 最多扫 3 个群

# 表达注入：reply 时注入本群常用表达到 prompt
EXPRESSION_INJECT_ENABLED=false
EXPRESSION_INJECT_COUNT=5               # 注入几条表达

# 黑话推断阈值：count 达到这些值时触发 LLM 推断含义
JARGON_INFERENCE_THRESHOLDS=4,8,25,100

# 黑话查询 skill：让 bot 看到不懂的词主动查
JARGON_QUERY_ENABLED=false

# === 心情系统 (Stage E) ===
# Bot 每个群独立 valence ∈ [-100, 100]：
#   - 被 @ + 正向回复 → +5；被骂 → -10；被心骂 → -15
#   - 发言被 ignore → -3；多人接 → +5
#   - mute 软 -8 / 硬 -20 / 自禁 -15
# 按时间指数衰减回归 0
# 关闭时（默认）：完全不读不写 DB，零开销
MOOD_ENABLED=false
MOOD_DECAY_RATE_PER_HOUR=0.3      # 每小时衰减 30%（1h 后保留 70%，2h 后 49%）

# 把心情提示注入 reply prompt 的 style 层（影响语气）
MOOD_INJECT_ENABLED=false
MOOD_INJECT_THRESHOLD=20          # |valence| < 该值时不注入（calm 不打扰）

# === 自我记忆 (Stage F) ===
# Bot 记得自己最近对每个用户说过什么，下次回复前注入 prompt 防止前后矛盾
# 关闭时（默认）：完全不读不写 DB
SELF_HISTORY_ENABLED=false
SELF_HISTORY_INJECT_LIMIT=5         # 每次注入最多几条
SELF_HISTORY_WINDOW_DAYS=30         # 只看最近多少天

# === 关系叙事 (Stage F) ===
# 每对 (chat, user) 累计 affinity 分数，影响说话语气
#   - 老朋友 / 亲近：更随意亲昵
#   - 反感：偏冷淡偏短
RELATIONSHIP_ENABLED=false
RELATIONSHIP_INJECT_THRESHOLD=20    # |affinity| < 该值不注入（一般关系不打扰）

# === Idle 沉默主动开口 cron ===
# 群沉默超过 IDLE_THRESHOLD_SEC 后，每 5 分钟检查一次，以 IDLE_TRIGGER_PROBABILITY 概率发起话题
# IDLE_PROACTIVE_INTERVAL_SEC 控制同群两次开口最小间隔（默认 86400 = 一天最多 1 次）
IDLE_PROACTIVE_INTERVAL_SEC=86400      # 一天最多 1 次（之前是硬编码 3 小时）
IDLE_THRESHOLD_SEC=3600                # 群沉默 1 小时才考虑
IDLE_TRIGGER_PROBABILITY=0.1           # 命中阈值后 10% 概率真发
IDLE_HOUR_START=10                     # 北京时间 10:00 起
IDLE_HOUR_END=23                       # 北京时间 23:00 止

# ── Turn Actor(MaiBot MaiSaka 式 per-chat 认知回合;详见 docs/turn-actor/)──
# 全部默认 false/缺省。关闭时行为与改造前完全一致。
# TURN_ACTOR_ENABLED=false           # G1 总开关:per-chat 回合 actor
# TURN_ACTOR_CHAT_IDS=               # 灰度群(逗号分隔 chatId,空=全部)
# TURN_ABORT_ENABLED=false           # G3 新消息打断在飞生成并重规划
# TURN_INTERRUPT_MAX_CONSECUTIVE=1   # 连续打断上限
# TURN_INTERRUPT_QUIET_MS=1000       # 打断后静默期(ms)
# TURN_MAX_INTERNAL_ROUNDS=4         # 回合内部轮次预算
# TURN_BURST_JUDGE_ENABLED=false     # G4 整 burst 判断
# TURN_WAIT_RESUME_ENABLED=false     # G5 wait 到期带锚点重入
# TURN_UNANSWERED_REVISIT_ENABLED=false # G7 回访未回应消息
# TURN_ACTION_PLANNER_ENABLED=false  # G2 统一动作空间
# TURN_SELF_FOLLOWUP_ENABLED=false   # G6 自我接话
# TURN_SELF_FOLLOWUP_MAX=2
# TURN_FOCUS_ENABLED=false           # G9 focus 标量
# TURN_PROACTIVE_ENABLED=false       # G11 proactive 经 turn actor
# TURN_UNIFIED_DECISION_ENABLED=false # G8 合并人格决策(最后上)
# TURN_GATE_DEFER_COOLDOWN=false     # gate 冷却语义改向(延后而非放行)
# ANTI_REPEAT_ENABLED=false          # G13 反重复守卫
# ANTI_REPEAT_THRESHOLD=0.85

# ── AGI-like durable cognition (首个纵向切片) ──
# 事件默认持久化；可按需关闭以做紧急回滚（不影响 legacy 回复）。
COGNITIVE_EVENTS_ENABLED=true
# COGNITIVE_OUTBOX_ENABLED=true
# COGNITIVE_KERNEL_ENABLED=false             # NyatOS trigger/frame/action shadow ledger
# COGNITIVE_KERNEL_CHAT_IDS=            # kernel shadow 灰度 chatId，空=开启后全量
# COGNITIVE_KERNEL_RECOVERY_ENABLED=false # 关闭超预算的 dispatched action（只写 interrupted，不重发）
# COGNITIVE_WORKSPACE_V2_ENABLED=false
# COGNITIVE_ROUTING_ENABLED=false       # 复杂度路由 shadow 指标，不改变行为
# SOCIAL_ACT_SHADOW_ENABLED=false       # 旧 judge -> SocialAct 行动观测，只写 metadata
# SOCIAL_ACT_SHADOW_CHAT_IDS=           # 灰度 chatId，空=显式开启后全量
# COGNITIVE_CONTINUITY_ENABLED=false    # 任务/进程唤醒账本，只写事件，不执行工具
# COGNITIVE_CONTINUITY_INTERVAL_SEC=60
# COGNITIVE_PROCESS_RUNTIME_ENABLED=false # 宿主执行有界场投影并 checkpoint wake
# COGNITIVE_ROUTING_BEHAVIOR_ENABLED=false # 深 Reply/有信号后台 tick 可选启用 scoped workspace
# COGNITIVE_ROUTING_CHAT_IDS=-1001234567890 # 空=全量；非空=路由行为灰度群
# MULTI_AGENT_ROUTE_CONVERGENCE_ENABLED=false # 按路由收敛专家；默认保持 legacy
# MULTI_AGENT_ROUTE_CHAT_IDS=-1001234567890 # 空=不灰度，显式 allowlist 才生效
# SOCIAL_PREDICTION_ENABLED=false       # 群互动预测/沉默结算，仅写 metadata ledger
# DEBT_AUTO_MATCH_ENABLED=false
# DEBT_SEMANTIC_MATCH_ENABLED=false
# DEBT_SEMANTIC_MATCH_USAGE=judge
# DEBT_SEMANTIC_MATCH_MAX_CANDIDATES=4
# DEBT_SEMANTIC_MATCH_MIN_SCORE=0.72
# DEBT_SEMANTIC_MATCH_TIMEOUT_MS=2500
# GROUP_NORMS_AUTO_UPDATE_ENABLED=false
# Core 仍保持 shadow/graylist，未完成 canary 前不要打开 authority。
# CORE_V2_ENABLED=true
# CORE_BELIEF_VIEW_ENABLED=false
# CORE_BLACKBOARD_ENABLED=false
# CORE_PERMISSION_GATE_ENABLED=false
# Agency 运行模式：shadow 只记录提案；advisory 只给 legacy 建议；canary 仅允许白名单群的低风险动作；authority 才允许不可逆动作。
# AGENCY_RUNTIME_MODE=shadow
# AGENCY_CANARY_CHAT_IDS=-1001234567890
# AGENCY_MAX_LLM_CALLS=2
# AGENCY_MAX_TOOL_CALLS=8
# AGENCY_FAIL_CLOSED=true
# AGENCY_CODEACT_TRANSPORT_ENABLED=false
# AGENCY_REPLY_TRANSPORT_ENABLED=false
# AGENCY_WAIT_TRANSPORT_ENABLED=false
# AGENCY_LEGACY_REPLY_OBSERVATION_ENABLED=false

# ── Computer-use isolation ──
# 终端启用时要求 bwrap；隔离能力不可用就拒绝执行，不回退宿主 shell。
# SANDBOX_ENABLED=false
# SANDBOX_TERMINAL_ENABLED=true
# SANDBOX_BWRAP_ENABLED=true
# SANDBOX_REQUIRE_ISOLATION=true

# ── NyatDB(嵌入式页式存储引擎;ChatLog 已接线,Hot/Impulse/Bond/Recall 待接)──
# 详见 packages/nyatdb/README.md 和 native/nyatdb/
# NYATDB_ENABLED=false               # 总开关:启用 NyatDB 引擎
# NYATDB_PATH=./data/nyatdb          # 数据目录(heap.ndb + wal/ + snap/)
# NYATDB_DUAL_WRITE=false            # 写入 ChatLog(历史名;REDIS_MIRROR=false 时是唯一写)
# NYATDB_READ=false                  # 读取优先 NyatDB,fallback Redis
# NYATDB_REDIS_MIRROR=false          # 同时写 Redis ctx(DUAL_WRITE 开时生效)
# NYATDB_NATIVE=false                # 优先用 Rust 原生引擎(需 npm run build:nyatdb)
# NYATDB_SYNC_EVERY=8                # 每 N 次 WAL append fsync 一次
# NYATDB_POOL_FRAMES=64              # 缓冲池帧数(每帧 4KB)
# NYATDB_MAX_MESSAGES_PER_CHAT=5000  # 单群消息上限(trim)
# NYATDB_CHAT_RING_MAX=200           # 内存 ring buffer 大小
# NYATDB_VERIFY_ON_OPEN=false        # 开库时全页 CRC 校验(慢,调试用)

# ── 语义重复守卫（同义改写刷屏）─────────────────────────────
# 同一个 CodeAct 任务里，bot 把"一个意思"换个说法再发一遍（"困到流口水了"→"困到打哈欠了"）。
# 字面 bigram Jaccard ≥0.85 的 ANTI_REPEAT 抓不到同义改写（实测相似度仅 0.13~0.27），
# 所以在第 2+ 次任务内发送时用 TypeSafe System One (Jev) 问一个 Noul。
# 仅在任务内第 2+ 次发送时调用（首次发送零成本）；JeV 不可达一律 fail-open 放行。
# SEMANTIC_DUP_ENABLED=false            # 总开关(默认关)
# SEMANTIC_DUP_THRESHOLD=0.7            # "是同义重复"的概率阈值(0-1)
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_API_KEY=                     # secret，只放 .env，切勿提交

# ── 接地性守卫（模型幻觉）─────────────────────────────────
# bot 断言一个"聊天里没人提过、用户也没问"的具体数字/事实。2026-09-19 事故：
# 无锚点消息「（想到瞭不好的東西）」→「2698 换块屏，苹果这刀法确实狠喵」——
# 该话题在本群 441 条历史里零命中，是从参数化知识里抓来的。
# 确定性闸门（含具体数字才问）+ 一次 JeV 调用；不可达一律 fail-open 放行。
# GROUNDING_CHECK_ENABLED=false         # 总开关(默认关)
# GROUNDING_PRESENT_MAX=0.35            # "这个话题聊天里出现过"低于此值算没提过
# GROUNDING_ASKED_MAX=0.35              # "用户是在问这个话题吗"低于此值算没在问；两者都低才拦

# ── 定型判断基座 src/ai/judge-substrate.ts ───────────────────────
# bot 每天 ~45M token 大多花在"换回一个小决定"（gate 三选一 / heart 说·等·不说 /
# shadow / judge）。把这类判断收敛到一个可插拔基座：typesafe(System One)主后端，
# 既有 chat LLM+JSON 兜底。底线：fail-open；DM(chatId>0)与 private 内容不走外部服务；
# 可整体关掉。成本走 llmEvents → llm_token_daily，换后端省多少是财报不是感觉。
# JUDGE_SUBSTRATE_ENABLED=false          # 总开关(默认关)
# JUDGE_SUBSTRATE_BACKEND=typesafe       # typesafe | chat
# JUDGE_SUBSTRATE_TIMEOUT_MS=3000
# JUDGE_SUBSTRATE_CACHE_TTL_MS=120000    # 同一 key+state 的重复判断走缓存
# JUDGE_SUBSTRATE_BREAKER_FAILS=3        # 连续失败 N 次后熔断
# JUDGE_SUBSTRATE_BREAKER_COOLDOWN_MS=60000

# ── 房间感知注入 src/subagent/room-awareness.ts ──────────────────
# 真人对比分析（2026-09-19）：bot 每句话都锚在"上一条消息"上，从不在"参与圈子"；
# 而真人会主动贡献知识、讲自己的事、看圈子在跟谁聊。frame.ts 早算好了这些信号
# （谁在跟谁说话/我多久没说话/未了话题/是不是在跟别人说），但以前只喂 NyatOS shadow
# （生产只开 3 个群），主回复路径一个字都用不到。此 flag 把 frame 渲染进 CodeAct prompt。
# ROOM_AWARENESS_ENABLED=false          # 默认关；读不到就跳过，绝不阻断任务

# 冲动史接线：把 NyatOS 单决策点"想说什么"的判定读回来渲染进生成 prompt。
#  数据早就在记（近 6 小时 226 次 speak / 155 次确认"想说却没说"），只是没有读者。
#  代价：buildFrame 多一次 SQLite 查询，且只在 withImpulses=true（生成路径）时发生——
#  shadow 每条消息都 buildFrame，它不付这笔钱。
# 覆盖面：只有 NYATOS_SHADOW_CHAT_IDS 里的群有这份数据。

# 影子判定失败的可诊断性：失败不再只走 debug。shadow_error 现在带 errorHint
#  （异常类名+消息，截断到 120 字）并写进 cognitive_events，且日志升到 warn。
#  背景：此前所有失败都塌缩成 why='shadow_error'，生产 level 30 下既看不到原因、
#  账本里也跟一句真的"沉默"一模一样——实测 6 小时 37 次（占该时段判定 14%）却一次都诊断不了。

# drive satiation 半衰期（秒）。注意：本表 updated_at 的唯一用途就是 satiation 的
#  衰减计时——历史上 setDriveValue 每次 tick 顺手刷新它，导致 satiation 永远钉在 1.0、
#  所有社交动作被 suppressor 永久否决（4 天 66/81 veto、0 次主动发言）。已修复。

# 自己约自己（self_scheduled_wake）：bot 说"这事我过几分钟再想想"的唯一途径。
#  此前 scheduleSelfWake()/listDueSelfWakes() 都已实现但**零调用者、零数据**——
#  写入方和读取方都写好了，两边都没接线，bot 于是没有任何主动发起未来的能力。
#  现在：runtime.scheduleSelfWake(要再想什么, 秒) 暴露给 LLM；到点后由
#  room-awareness 以「[你约过自己的事]」呈现给它自己（不是宿主替它做，是把念头还给它）。

# tick 决策记账：unified-tick 现在把自己的选择写进 cognitive_events（type=tick_verdict）：
#  选了什么 / 被哪条否决链 veto / 为什么 quiet。此前它全文 0 次写账本，
#  于是 own_action_result(32) vs bot_delivery(1092) 的 2.9% 结构性无记录
# 无法归因——账本看不见自己的选择之前，能动性任何指标都不可测。纯 host 写入，零 token。

# ── Nyat Trench L0 海床（论文 docs/plans/2026-09-19-nyat-trench.md）──────
# v1「身体先行」：纯增量，不动任何现有决策路径。heart/judge/gate 照旧跑，
# 只是 Frame 里多一行身体感受，且气压 P 有了唯一衰减方（时间泵 cron）。
# 结构性保证：P=0 时 r≥1.4 次/h（不会消失），P=12 时 r≤6 次/h（不会吵）。
# TRENCH_PUMP_ENABLED=false          # 时间泵（零 token，只有 Redis 读+写+一条 JSONL）

# ── Nyat Trench L2 反射（论文 §3.2 机制三）────────────────────────
# Echo：唯一的学习。用 bot_interactions 做纯 SQL 回扫，把主动发言的
#  outcome 从 98.7% unknown 补上；E ∈ [0.05,0.90] 硬钳，被无视/插砸才给海床脉冲。
#  零 LLM、零 token。E 的唯一写入方是本模块——没有第二个 setter。
# ECHO_ENABLED=false

# ── Nyat Trench L1 沟壁：发送前硬闸 ────────────────────────────────
# 把 canSpeakActively()（论文 §1.2 实测：全仓库唯一引用是它自己的定义）变成
# 唯一发送出口的前置条件。此前"6条/h+90s"靠发送后 fire-and-forget 计数执行。
# 只拦主动发言（无引用锚点）；被@/被回复/DM 豁免。拦下时不静默丢弃——
# 把"你嗓子有点哑"作为事实抛回给模型（世界回弹）。
# TRENCH_GATE_ENABLED=false

# ── Nyat Trench L1 包络（对所有发言生效，含被叫到的）────────────────
# 缺口：原 participation budget 只拦"主动发言"（无引用锚点），而生产 1572 次群发送
#  全部带锚点=全部豁免；最忙群 266 条/天(11/h) 已超 6/h 上限而无人管。
#  物理边界在有锚点的那条路上是个洞——而那条路承载全部流量。
# 这里补的是"突发包络"（形状），不是总量节制：bot 该爱说话，
#  但不该一秒钟回十条。默认 shadow：只记录"本来会被拦"，先看数再 enforce。
# TRENCH_ENVELOPE_MODE=enforce           # off | shadow | enforce（已回测：150/100 拦 0.1%）
# TRENCH_BURST_MAX=8                   # 窗口内最多几条
# TRENCH_BURST_WINDOW_SEC=300          # 窗口长度（秒）

# Nyat Trench Phase 1：Meta heart 旁路开关。它实测是实际做抑制的那层
#  （12,009 次判定只放行 7.7%，而 shadow 想 speak 85.6%）。
#  false = 旁路它的 allow/silence，消息按既有 layer 分级直接进 attention。
#  翻它之前必须先：envelope 已 enforce 且读过真实拦截率 + 金丝雀有对照基线。
#  顺序反了就是把刹车片拔了再装新的。
# META_HEART_ENABLED=true
