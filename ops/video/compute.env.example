# Install with root:root 0600. Use a dedicated random credential, never BOT_TOKEN.
VIDEO_COMPUTE_TOKEN=
VIDEO_COMPUTE_PROFILE=/opt/nyatbot-video-compute/profile.json
# sha256 of JSON.stringify([ffmpeg_sha256, ffprobe_sha256]), lowercase hex.
VIDEO_COMPUTE_DECODER_SHA256=
VIDEO_COMPUTE_HOST=127.0.0.1
VIDEO_COMPUTE_PORT=3041
VIDEO_COMPUTE_CONCURRENCY=1
