[Unit]
Description=xxb-ts Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=__WORKDIR__
EnvironmentFile=__ENV_FILE__
Environment=TZ=Asia/Shanghai
ExecStart=__NODE_BIN__ __ENTRYPOINT__
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
StandardOutput=append:__WORKDIR__/logs/app.log
StandardError=append:__WORKDIR__/logs/app.log

[Install]
WantedBy=multi-user.target
